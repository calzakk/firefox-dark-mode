{
  "manifest_version": 3,
  "name": "Firefox Dark Mode",
  "version": "1.0.0",
  "description": "Toggle page brightness and colour inversion.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-dark-mode@cyotec.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icons/dark-mode.svg",
    "96": "icons/dark-mode.svg"
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Toggle dark mode",
    "default_icon": "icons/dark-mode.svg"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle dark mode"
    }
  }
}
